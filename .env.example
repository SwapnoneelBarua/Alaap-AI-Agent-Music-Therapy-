# Local Ollama chat model. The default qwen3.5:4b is already installed on this machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Jamendo read-only catalog search uses the Client ID. The secret is only for OAuth write/user features.
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# Optional local overrides
# RAG_DOCS_DIR=../RAG DOCs
# CHROMA_DIR=./data/chroma
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ALAAP_ALLOWED_ORIGINS=http://localhost:3000
